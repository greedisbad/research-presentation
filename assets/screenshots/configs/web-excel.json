{
  "project": "web-excel",
  "outDir": "web-excel",
  "viewport": { "width": 1500, "height": 1000 },
  "note": "纯静态站（无 package.json），用 vite preview 托管端口 4182。六个候选 Demo 各自独立页面，依赖 CDN。",
  "steps": [
    { "action": "goto", "url": "http://127.0.0.1:4182/", "name": "打开选型实验室首页" },
    { "action": "wait", "ms": 3000 },
    {
      "action": "screenshot",
      "shot": "01-选型实验室首页.png",
      "name": "选型实验室索引页：六个候选方案卡片同屏（VXE / Tabulator / VTable / Jspreadsheet / AG Grid / TOAST UI）",
      "fullPage": true
    },

    { "action": "goto", "url": "http://127.0.0.1:4182/demos/jspreadsheet.html", "name": "打开 Jspreadsheet 演示" },
    { "action": "wait", "ms": 5000 },
    {
      "action": "screenshot",
      "shot": "02-Jspreadsheet演示.png",
      "name": "Jspreadsheet CE 交互演示页：电子表格形态与选区合并行为",
      "fullPage": true
    },

    { "action": "goto", "url": "http://127.0.0.1:4182/demos/tabulator.html", "name": "打开 Tabulator 演示" },
    { "action": "wait", "ms": 5000 },
    {
      "action": "screenshot",
      "shot": "03-Tabulator演示.png",
      "name": "Tabulator 交互演示页：宽表、列筛选与虚拟滚动",
      "fullPage": true
    },

    { "action": "goto", "url": "http://127.0.0.1:4182/demos/vxe.html", "name": "打开 VXE Table 演示" },
    { "action": "wait", "ms": 5000 },
    {
      "action": "screenshot",
      "shot": "04-VXE演示.png",
      "name": "VXE Table 交互演示页",
      "fullPage": true
    },

    { "action": "goto", "url": "http://127.0.0.1:4182/demos/vtable.html", "name": "打开 VTable 演示" },
    { "action": "wait", "ms": 5000 },
    {
      "action": "screenshot",
      "shot": "05-VTable演示.png",
      "name": "VTable 交互演示页",
      "fullPage": true
    },

    { "action": "goto", "url": "http://127.0.0.1:4182/", "name": "回到首页" },
    { "action": "wait", "ms": 2000 },
    {
      "action": "click",
      "selector": "a[href=\"docs/05-validation.md\"]",
      "optional": true,
      "name": "打开验证文档（若为链接）"
    },
    { "action": "wait", "ms": 1500 }
  ]
}
